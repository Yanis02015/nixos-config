{
  "title": "SUPER façon Hyprland pour AeroSpace",
  "rules": [
    {
      "description": "Caps Lock → Cmd+Ctrl+Opt (modificateur AeroSpace, Shift reste libre pour les variantes)",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "caps_lock",
            "modifiers": { "optional": ["any"] }
          },
          "to": [
            {
              "key_code": "left_command",
              "modifiers": ["left_control", "left_option"]
            }
          ]
        }
      ]
    }
  ]
}
