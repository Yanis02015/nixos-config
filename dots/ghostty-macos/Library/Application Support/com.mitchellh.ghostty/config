# Surcharges macOS de dots/ghostty/.config/ghostty/config. Ghostty lit ce fichier
# (~/Library/Application Support/com.mitchellh.ghostty/config) après la config XDG,
# et seulement sur macOS : c'est l'endroit pour ce qui ne doit pas toucher Linux.

# `window-decoration = false` (voulu sous Hyprland) rend les coins carrés sur macOS,
# et la bordure arrondie de JankyBorders ne colle plus aux coins. "hidden" cache la
# barre de titre mais garde le cadre et les coins arrondis natifs.
window-decoration = auto
macos-titlebar-style = hidden

# Option gauche = Alt (binds tmux M-h/j/k/l, zsh, nvim) ; Option droite garde la
# saisie AZERTY Mac de { } [ ] | ~ \
macos-option-as-alt = left

# Défaut false sur macOS : chaque `open -na` (scripts/mac-ghostty.sh) laisserait une
# instance vide dans le Dock après fermeture de sa fenêtre.
quit-after-last-window-closed = true
