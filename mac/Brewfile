# Brewfile du Mac (MacBook M5 Pro) : de quoi retrouver le bureau Hyprland + le terminal, rien de plus.
#   Installer / mettre à jour :            brew bundle --file ~/nixos-config/mac/Brewfile
#   Voir ce qui manque :                   brew bundle check --file ~/nixos-config/mac/Brewfile
#   Voir ce qui est en trop (sans rien     brew bundle cleanup --file ~/nixos-config/mac/Brewfile
#   supprimer ; --force pour désinstaller)
#
# Installer au fil des besoins : décommenter une ligne de la section « À la demande »
# puis relancer `brew bundle`, pour garder ce fichier à jour.
#
# Pas de nix-darwin ici, choix volontaire : sur macOS les apps graphiques passent de
# toute façon par les casks, et leurs auto-updaters marchent.

tap "nikitabobko/tap"     # AeroSpace
tap "FelixKratz/formulae" # JankyBorders

# ── bureau façon Hyprland ──────────────────────────────────────
cask "aerospace"                   # tiling WM, config : dots/aerospace
brew "FelixKratz/formulae/borders" # bordure de la fenêtre active
cask "karabiner-elements"          # Caps Lock → touche SUPER, config : dots/karabiner
cask "raycast"                     # launcher (SUPER+Espace) + historique presse-papier (SUPER+C)

# ── terminal ───────────────────────────────────────────────────
cask "ghostty"
cask "font-maple-mono-nf"          # police de la config Ghostty
brew "tmux"
brew "sesh"                        # SUPER+T / prefix+s
brew "fzf"                         # requis par sesh-picker.sh
brew "fd"                          # requis par sesh-picker.sh (ctrl-f)
brew "stow"                        # déploie dots/
brew "k9s"

# ── apps ───────────────────────────────────────────────────────
cask "claude"
cask "zen"
cask "google-chrome"

# ── À la demande (décommenter quand le besoin arrive) ──────────
# Les binds AeroSpace correspondants (SUPER+Shift+E/D/O/W) ne font rien tant que l'app manque.
