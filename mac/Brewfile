# Brewfile du Mac (MacBook M5 Pro) : apps + terminal, gestion des fenêtres 100 % native macOS.
# (AeroSpace, JankyBorders, Karabiner, Raycast essayés puis retirés le 2026-10-05, voir CLAUDE.md)
#   Installer / mettre à jour :            brew bundle --file ~/nixos-config/mac/Brewfile
#   Voir ce qui manque :                   brew bundle check --file ~/nixos-config/mac/Brewfile
#   Voir ce qui est en trop (sans rien     brew bundle cleanup --file ~/nixos-config/mac/Brewfile
#   supprimer ; --force pour désinstaller)
#
# Installer au fil des besoins : décommenter une ligne de la section « À la demande »
# puis relancer `brew bundle`, pour garder ce fichier à jour.
#
# Pas de nix-darwin ici, choix volontaire : sur macOS les apps graphiques passent de
# toute façon par les casks, et leurs auto-updaters marchent.

# Homebrew ≥ 6 refuse les taps tiers non approuvés (`brew trust`). `trusted: true` les
# approuve ; l'URL explicite est nécessaire, sinon l'option est ignorée silencieusement
# (bug Homebrew/brew#22668).
tap "yanis02015/tap", "https://github.com/Yanis02015/homebrew-tap", trusted: true # casks perso (apps absentes de Homebrew)
tap "jackielii/tap", "https://github.com/jackielii/homebrew-tap", trusted: true   # skhd.zig
tap "mmathys/tap", "https://github.com/mmathys/homebrew-tap", trusted: true       # noswoosh

# ── terminal ───────────────────────────────────────────────────
# Terminal d'Apple (Ghostty retiré du Mac le 2026-10-07, il reste le terminal sous Linux)
cask "font-maple-mono-nf"          # Nerd Font : icônes du prompt Starship (ex. branche git)
brew "tmux"
brew "sesh"                        # tmux prefix+s
brew "fzf"                         # requis par sesh-picker.sh
brew "fd"                          # requis par sesh-picker.sh (ctrl-f)
brew "stow"                        # déploie dots/
brew "k9s"

# ── raccourcis globaux ─────────────────────────────────────────
cask "jackielii/tap/skhd-zig"      # Option gauche + Entrée → Terminal, config : dots/skhd
cask "mmathys/tap/noswoosh"         # Ctrl+←/→ et swipe 3 doigts : bureaux sans animation (macOS ≥ 26.6)

# ── shell (dots/zsh/.zshrc) ────────────────────────────────────
brew "starship"                    # prompt, config : dots/starship
brew "zsh-autosuggestions"
brew "zsh-syntax-highlighting"
brew "zsh-history-substring-search"
brew "zoxide"
brew "direnv"

# ── dev ────────────────────────────────────────────────────────
brew "git"
brew "gh"
brew "node"
brew "pnpm"                        # pas corepack : il n'est plus livré avec Node depuis la v25
brew "uv"                          # Python (`uv python install`), venvs, uvx ; à la place de brew "python",
                                   # dont les montées de version cassent les venvs
cask "orbstack"                    # Docker. Gratuit en usage perso SEULEMENT, pro = licence Pro (8 $/mois/utilisateur).
                                   # En test le 2026-10-07 avant de décider pour le travail ; alternative gratuite :
                                   # brew "colima" + brew "docker" + brew "docker-compose"

# ── apps ───────────────────────────────────────────────────────
cask "claude"
cask "zen"
cask "zed"
cask "google-chrome"
cask "yanis02015/tap/clipcascade"  # presse-papier partagé avec NixOS, serveur : http://192.168.2.15:8080 (homelab)
cask "maccy"                       # historique du presse-papier (équivalent du panneau clipboard quickshell)

